{
  "log": {
    "disabled": false,
    "level": "warn",
    "output": "/data/adb/box/run/sing-box.log",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "hosts",
        "type": "hosts",
        "predefined": {
          "dns.alidns.com": [
            "223.5.5.5",
            "223.6.6.6"
          ],
          "doh.pub": [
            "1.12.12.21",
            "120.53.53.53"
          ],
          "dns.google": [
            "8.8.8.8",
            "8.8.4.4"
          ],
          "cloudflare-dns.com": [
            "104.16.248.249",
            "104.16.249.249"
          ]
        }
      },
      {
        "tag": "cf-doh",
        "type": "https",
        "server": "cloudflare-dns.com",
        "detour": "📦 手动选择",
        "domain_resolver": "hosts"
      },
      {
        "tag": "gg-doh",
        "type": "https",
        "server": "dns.google",
        "detour": "📦 手动选择",
        "domain_resolver": "hosts"
      },
      {
        "tag": "ali-doh",
        "type": "https",
        "server": "dns.alidns.com",
        "domain_resolver": "hosts"
      },
      {
        "tag": "tx-doh",
        "type": "https",
        "server": "doh.pub",
        "domain_resolver": "hosts"
      },
      {
        "tag": "ali-udp",
        "type": "udp",
        "server": "223.5.5.5"
      },
      {
        "tag": "tx-udp",
        "type": "udp",
        "server": "119.29.29.29"
      },
      {
        "tag": "fakeip",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      },
      {
        "tag": "local",
        "type": "local",
        "neighbor_domain": [
          ".local",
          ".lan"
        ]
      }
    ],
    "rules": [
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "clash_mode": "规则-放行广告",
            "invert": true
          },
          {
            "rule_set": [
              "Ads_SukkaW",
              "Ads_fix",
              "Webrtc"
            ]
          }
        ],
        "action": "reject"
      },
      {
        "clash_mode": "全局代理",
        "action": "route",
        "server": "fakeip"
      },
      {
        "clash_mode": "全局直连",
        "action": "route",
        "server": "ali-doh"
      },
      {
        "rule_set": "Tencent",
        "server": "tx-doh"
      },
      {
        "rule_set": [
          "Direct_fix",
          "ChinaDomain"
        ],
        "server": "ali-udp"
      },
      {
        "rule_set": "GoogleFCM",
        "server": "gg-doh"
      },
      {
        "rule_set": [
          "Binance",
          "PayPal"
        ],
        "server": "cf-doh"
      },
      {
        "query_type": "HTTPS",
        "action": "reject"
      },
      {
        "domain_suffix": [
          "lancache.steamcontent.com",
          "10099.com.cn",
          "msftconnecttest.com",
          "msftncsi.com",
          "local",
          "lan",
          "home",
          "internal",
          "corp",
          "example.com",
          ".invalid",
          ".test",
          ".home.arpa"
        ],
        "server": "local"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "action": "route",
        "server": "fakeip",
        "rewrite_ttl": 1
      }
    ],
    "final": "cf-doh",
    "reverse_mapping": true,
    "optimistic": true,
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
    {
      "type": "tproxy",
      "tag": "tproxy-in",
      "listen": "::",
      "listen_port": 9898
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "::",
      "listen_port": 7890
    },
    {
      "type": "socks",
      "tag": "telegram-socks",
      "listen": "127.0.0.1",
      "listen_port": 6153
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "📦 手动选择",
      "outbounds": [
        "⚡ 自动选择",
        "direct"
      ],
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "📥 数据下载",
      "outbounds": [
        "direct",
        "⚡ 自动选择"
      ],
      "default": "direct",
      "interrupt_exist_connections": true
    },
    {
      "type": "urltest",
      "tag": "⚡ 自动选择",
      "url": "http://cp.cloudflare.com/generate_204",
      "interval": "5m0s",
      "tolerance": 10,
      "interrupt_exist_connections": true,
      "outbounds": []
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff",
        "sniffer": [
          "http",
          "tls",
          "quic",
          "dns"
        ]
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "domain": [
          "广告域名放行测试1",
          "广告域名放行测试2"
        ],
        "outbound": "direct"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "clash_mode": "规则-放行广告",
            "invert": true
          },
          {
            "rule_set": [
              "Ads_SukkaW",
              "Ads_fix",
              "Webrtc"
            ]
          }
        ],
        "action": "reject",
        "method": "drop"
      },
      {
        "clash_mode": "全局代理",
        "outbound": "📦 手动选择"
      },
      {
        "clash_mode": "全局直连",
        "outbound": "direct"
      },
      {
        "rule_set": "GoogleFCM",
        "outbound": "direct"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "inbound": [
              "telegram-socks"
            ]
          },
          {
            "rule_set": [
              "Telegram"
            ],
            "invert": true
          }
        ],
        "action": "reject",
        "method": "drop"
      },
      {
        "rule_set": "ChinaDomain",
        "outbound": "direct"
      },
      {
        "action": "resolve"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "rule_set": "ChinaIP",
        "outbound": "direct"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "Ads_SukkaW",
        "format": "binary",
        "url": "https://v6.gh-proxy.org/https://raw.githubusercontent.com/ljrgov/conf/refs/heads/main/sing-box/rules/Ads_SukkaW.srs",
        "update_interval": "24h0m0s"
      },
      {
        "type": "remote",
        "tag": "Ads_fix",
        "format": "binary",
        "url": "https://v6.gh-proxy.org/https://raw.githubusercontent.com/ljrgov/conf/refs/heads/main/sing-box/rules/Ads_fix.srs",
        "update_interval": "24h0m0s"
      },
      {
        "type": "remote",
        "tag": "Webrtc",
        "format": "binary",
        "url": "https://v6.gh-proxy.org/https://raw.githubusercontent.com/ljrgov/conf/refs/heads/main/sing-box/rules/Webrtc.srs",
        "update_interval": "24h0m0s"
      },
      {
        "type": "remote",
        "tag": "GoogleFCM",
        "format": "binary",
        "url": "https://v6.gh-proxy.org/https://raw.githubusercontent.com/ljrgov/conf/refs/heads/main/sing-box/rules/GoogleFCM.srs",
        "update_interval": "24h0m0s"
      },
      {
        "type": "remote",
        "tag": "Telegram",
        "format": "binary",
        "url": "https://v6.gh-proxy.org/https://raw.githubusercontent.com/ljrgov/conf/refs/heads/main/sing-box/rules/Telegram.srs",
        "update_interval": "24h0m0s"
      }
    ],
    "final": "📥 数据下载",
    "default_domain_resolver": "ali-doh",
    "default_http_client": "download",
    "auto_detect_interface": true,
    "find_process": true
  },
  "http_clients": [
    {
      "tag": "download",
      "version": 2,
      "detour": "📥 数据下载"
    }
  ],
  "services": [
    {
      "type": "api",
      "listen": "127.0.0.1",
      "listen_port": 9091,
      "secret": "",
      "dashboard": false
    }
  ],
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache.db",
      "store_fakeip": true
    },
    "clash_api": {
      "default_mode": "规则-拦截广告",
      "external_controller": "127.0.0.1:9090",
      "external_ui": "dashboard",
      "external_ui_download_url": "https://v6.gh-proxy.org/https://github.com/Zephyruso/zashboard/archive/refs/heads/gh-pages-no-fonts.zip",
      "secret": "",
      "access_control_allow_private_network": true
    }
  },
  "endpoints": []
}